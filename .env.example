# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your key:
#
#     cp .env.example .env.local
#
# .env.local is gitignored and never committed. Next.js loads it automatically
# and picks up changes without a restart.
# ─────────────────────────────────────────────────────────────────────────────


# REQUIRED. A free key takes about a minute at https://console.groq.com/keys
# — no card needed. Without it the app still runs and shows a designed
# "no API key configured" state rather than crashing.
GROQ_API_KEY=


# OPTIONAL. Defaults to openai/gpt-oss-120b.
# The app falls back to openai/gpt-oss-20b, then qwen/qwen3.8-27b, if a model
# is unavailable — a model was retired from the account mid-build, which is why
# the chain exists. Override only if you want to pin a specific one.
#
# GROQ_MODEL=openai/gpt-oss-20b


# OPTIONAL. Set to 1 to log every model call with its latency and token usage:
#
#     LLM_DEBUG=1 npm run dev
#     [llm] openai/gpt-oss-120b ok in 1491ms finish=stop prompt=1339 completion=465
#
# Useful on the free tier, which is limited to 8,000 tokens per minute rather
# than by request count. This is how the rate-limit behaviour was diagnosed.
#
# LLM_DEBUG=1
